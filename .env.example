# 우리 집 가계부 — 환경변수 예시
#
# 이 파일을 `.env.local` 이라는 이름으로 복사한 뒤 값을 채운다. `.env.local` 은 Git 에 올라가지 않는다.
# Claude Code 로 설치하면 [필수] 값과 SUPABASE_DB_PASSWORD 는 알아서 채워진다.
# 손으로 할 때는 SETUP.md 의 4번을 본다.

# ── [필수] Supabase 접속 ──────────────────────────────────────
# 프로젝트 주소. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# 화면이 쓰는 공개 키(anon).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버만 쓰는 관리 키(service_role). 남에게 보이면 안 된다.
SUPABASE_SERVICE_ROLE_KEY=

# ── [필수] 로그인 ID 뒤에 붙는 도메인 ─────────────────────────
# 로그인 ID `admin` 은 안에서 `admin@이 값` 으로 바뀐다. 실제 메일은 가지 않는다. 그대로 둬도 된다.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=example.com

# ── [기록용] DB 비밀번호 ──────────────────────────────────────
# 앱은 읽지 않는다. `npx supabase link` 로 다시 연결할 때 찾아보려고 적어 둔다. 남에게 보이면 안 된다.
SUPABASE_DB_PASSWORD=

# ── [선택] 관리자 계정 — `npm run setup:admin` 이 읽는다 ──────
# 로그인 ID. 비우면 admin. 다른 ID 로 만들었으면 적어 둔다(가상 자료와 켤 때 안내가 같은 ID 를 쓴다).
# ADMIN_LOGIN_ID=admin
# 화면에 보이는 이름. 비우면 "관리자".
# ADMIN_NAME=관리자
# 비밀번호를 직접 정할 때만(6자 이상). 비우면 무작위 12자를 만들어 화면에 한 번 보여 준다. 비워 두기를 권한다.
# ADMIN_PASSWORD=

# ── [문자수집을 켜면 필수] 크론 인증 ──────────────────────────
# 매일 한 번 30일 지난 문자 원문을 지우는 작업(/api/household/inbox/purge-raw)이 이 값으로 인증한다.
# 긴 임의 문자열. Vercel 환경변수에도 같은 값을 넣는다. 없으면 원문이 지워지지 않는다.
# 문자수집 토큰은 여기가 아니라 앱의 설정 → 문자수집에서 발급한다.
# CRON_SECRET=

# ── [선택] 시험용 ─────────────────────────────────────────────
# 로그인하는 시험(test:inbox-cancel, test:inbox-loan, test:table-render 등)이 쓰는 계정.
# 비밀번호는 지금 로그인되는 값을 적는다. setup:admin 으로 새로 만들었으면 여기도 바꾼다.
# 이 시험들은 DB 에 쓰고 지운다. 내 자료를 넣은 뒤에는 돌리지 않는다(SETUP.md "시험을 돌리기 전에").
# E2E_LOGIN_ID=admin
# E2E_LOGIN_PASSWORD=
# 개발 서버에 요청을 보내는 시험이 쓰는 주소. 시험마다 기본 포트가 달라 직접 적는 편이 안전하다.
# BASE_URL=http://localhost:3000
