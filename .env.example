# ─────────────────────────────────────────────────────────────
# 우리 집 가계부 환경변수
# 이 파일을 복사해서 `.env.local` 을 만들고 값을 채우세요.
#   cp .env.example .env.local        (Windows cmd: copy .env.example .env.local)
# Claude Code 로 "설치해줘" 하면 아래 [필수] 값을 CLI 로 조회해 자동으로 채워 줍니다.
# ─────────────────────────────────────────────────────────────

# [필수] Supabase 연결 정보
# `npx supabase projects api-keys --project-ref <ref>` 로 조회합니다. (대시보드 복사 불필요)
# URL 은 https://<project-ref>.supabase.co 형식입니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [참고] DB 비밀번호 — 앱 실행에는 쓰이지 않습니다.
# `npx supabase link` / `npx supabase db push` 등 CLI 작업에 필요해 기록용으로 보관합니다.
# 초기 설정을 Claude Code 로 진행하면 자동 생성되어 여기에 저장됩니다. (🔒 외부 공유 금지)
SUPABASE_DB_PASSWORD=

# [필수] 로그인 이메일 도메인
# 로그인 ID 뒤에 붙는 가상 이메일 도메인입니다. (예: admin → admin@example.com)
# 그대로 두어도 됩니다.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=example.com

# ─────────────────────────────────────────────────────────────
# 아래는 [선택] 입니다(CRON_SECRET 만 문자수집을 켤 때 필수). 비워두면 해당 기능만 동작하지 않을 뿐,
# 앱은 정상적으로 실행됩니다.
#
# 참고: 폰 문자 자동수집(선택 기능)의 토큰은 환경변수가 아니라 앱의
# [설정] ▸ 문자수집 탭에서 발급합니다. 여기에 넣을 값이 없습니다.
# ─────────────────────────────────────────────────────────────

# (선택) 관리자 계정 기본값 바꾸기 — `npm run setup:admin` 이 읽습니다.
# 비워두면 ID admin / 이름 관리자 로 만들고, 비밀번호는 설치 때 무작위로 만들어 화면에 보여 줍니다.
# ADMIN_PASSWORD 는 비워 두는 것을 권합니다. 적으면 그 값이 쓰입니다(6자 이상).
# ID 를 admin 이 아닌 값으로 만들었으면 ADMIN_LOGIN_ID 에 그 ID 를 적어 둡니다(다시 실행·더미 데이터·안내 배너가 씀).
# 명령 인자(`npm run setup:admin -- 아이디 비밀번호`)가 있으면 그쪽이 우선합니다.
# ADMIN_LOGIN_ID=admin
# ADMIN_NAME=관리자
# ADMIN_PASSWORD=

# (선택) 로그인 비밀번호 — 로그인하는 시험이 읽습니다. (🔒 외부 공유 금지)
# 로그인하는 시험: `test:inbox-cancel`, `test:inbox-loan`, `test:table-render` 가 이 값으로 로그인합니다.
#    없으면 앞의 둘은 "로그인 실패: Invalid login credentials" 로,
#    `test:table-render` 는 ".env.local 에 E2E_LOGIN_PASSWORD 가 없습니다" 로 멈춥니다.
#    설치 때 화면에 나온 비밀번호(또는 바꾼 비밀번호)를 적습니다. 로그인 ID 가 admin 이 아니면 E2E_LOGIN_ID 도 적습니다.
#    `npm run setup:admin` 을 다시 실행해 비밀번호가 바뀌었으면 여기도 새 값으로 바꿉니다.
#    ⚠️ 이 시험들은 DB 에 쓰고 지웁니다. 실제 데이터를 넣은 뒤에는 돌리지 마세요(SETUP.md 의 "시험을 돌리기 전에").
# E2E_LOGIN_ID=admin
# E2E_LOGIN_PASSWORD=

# (문자수집을 켜면 필수) Cron 엔드포인트 보호 (Vercel 배포 시)
# vercel.json 의 일일 크론(/api/household/inbox/purge-raw — 수집함 문자 원문 30일 정리)이
# `Authorization: Bearer <CRON_SECRET>` 으로 인증합니다. 아무 긴 임의 문자열을 넣고
# Vercel 환경변수에도 같은 값을 등록하세요. 없으면 앱은 동작하지만 크론이 401 로 거절되어 30일이 지난 문자 원문이 지워지지 않습니다.
# CRON_SECRET=

# (선택) 시험용 — dev 서버에 요청을 보내는 시험(`test:sms-ingest` 등)이 읽습니다. 일반 사용에는 불필요.
# dev 서버를 띄운 주소를 적습니다. 시험마다 기본값이 다르니(3000 또는 3100) 직접 적는 편이 안전합니다.
# 로그인 값은 위의 E2E_LOGIN_ID / E2E_LOGIN_PASSWORD 를 씁니다.
# BASE_URL=http://localhost:3000
