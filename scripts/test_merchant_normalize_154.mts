/**
 * 설계 154 — 상호 정리(법인표기·잘린 괄호·페이스페이 할인) 회귀 테스트.
 * 표본은 수집 원문의 **잘림 꼴을 그대로 본뜬 가상 예문**이다(설계 129 교훈).
 */
const { parseSms } = await import("../src/lib/household/sms");

let fail = 0;
function eq(label: string, raw: string, want: string | null) {
  const got = parseSms(raw).merchant;
  const ok = got === want;
  if (!ok) fail++;
  console.log(`  ${ok ? "✅" : "❌"} ${label}\n      [${raw.slice(0, 72)}]\n      기대=[${want}] 실제=[${got}]`);
}

console.log("\n[1] 잘린 법인표기를 없앤다 (요구 사항: '끊기는 게 없게')");
eq("해오름코리아（주(일시불)", "18,001원 결제 우리체크 | 해오름코리아（주(일시불)", "해오름코리아");
eq("은행 SMS 쪽 잘린 꼴", "[Web발신] 우리 08/06 19:09 *120000 출금 18,001원 해오름코리아（ 잔액 133,438원", "해오름코리아");

console.log("\n[2] 온전한 법인표기도 뺀다 (이해에 불필요 + 학습키가 갈린다)");
eq("(주)푸르미스퀘어", "10,013원 결제 우리체크 | (주)푸르미스퀘어(일시불)", "푸르미스퀘어");
eq("（주）해봄호텔앤", "8,001원 결제 우리체크 | （주）해봄호텔앤(일시불)", "해봄호텔앤");
eq("주식회사 카카오", "결제가 완료되었어요 주식회사 카카오에서 1,898원을 결제했어요.", "카카오");

console.log("\n[3] 페이스페이 할인 꼬리를 뺀다 (금액마다 학습키가 갈린다)");
eq("1,000원 할인", "2,361원 결제 토스뱅크 | 해봄워터파크 페이스페이 1,000원 할인", "해봄워터파크");
eq("3,000원 할인", "17,695원 결제 토스뱅크 | 해봄워터파크 페이스페이 3,000원 할인", "해봄워터파크");

console.log("\n[4] ★건드리면 안 되는 것 (오작동 방지)");
eq("정상 괄호는 보존", "5,000원 결제 우리체크 | (주)비바리퍼블리카(토스페이)(일시불)", "비바리퍼블리카(토스페이)");
eq("짧아지는 잘림은 손대지 않는다", "160,001원 결제 우리체크 | 다온집(한빛중앙점(일시불)", "다온집(한빛중앙점");
eq("법인표기 없는 평범한 상호", "12,000원 결제 우리체크 | 한빛놀이공원 (일시불)", "한빛놀이공원");
eq("페이스페이 옛 형식", "49,071원 결제 페이스페이 (토스뱅크) | 해봄식당", "해봄식당");

console.log("\n[5] 은행 SMS 적요 경로도 정리한다");
eq("체크카드출금 적요", "출금 25,012원이*다님 08/06 09:25 110-11-0***-111 (주)푸르미 체크카드출금 25,012 잔액3,581,174", "푸르미");
eq("적요가 기관명이면 그대로", "출금 355,516원 110-11-0***-111 KB카드출금 카드출금( 355,516 잔액1,000", "KB카드");

console.log(fail === 0 ? "\n전부 통과 ✅" : `\n${fail}건 실패 ❌`);
process.exit(fail === 0 ? 0 : 1);
